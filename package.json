{
  "name": "sippal",
  "version": "1.0.0",
  "description": "Hydration tracker with a desktop pet and a Gemini assistant",
  "author": "Aniruddh",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
