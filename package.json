{
  "name": "sippal",
  "version": "1.1.0",
  "description": "Windows hydration tracker with a charming desktop pet, alarms, schedule, a Gemini assistant and games. Built by Qubtic Labs.",
  "author": {
    "name": "Qubtic Labs",
    "url": "https://www.qubticlabs.studio/"
  },
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --win nsis --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "icon": "node scripts/make-icon.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "better-sqlite3": "^13.0.3",
    "node-schedule": "^2.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.3",
    "@types/node-schedule": "^2.1.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "chess.js": "^1.4.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.2",
    "zustand": "^5.0.15"
  },
  "build": {
    "appId": "com.sippal.app",
    "productName": "SipPal",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "resources/**",
      "node_modules/better-sqlite3/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "SipPal",
      "artifactName": "SipPal-Setup-${version}.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.healthcare-fitness",
      "icon": "resources/icon.png",
      "identity": "-",
      "artifactName": "SipPal-${version}-mac-${arch}.${ext}",
      "hardenedRuntime": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "icon": "resources/icon.png",
      "artifactName": "SipPal-${version}-linux-${arch}.${ext}",
      "synopsis": "Desktop hydration pet with alarms, schedule, AI and games"
    },
    "npmRebuild": false,
    "copyright": "Copyright © 2026 Qubtic Labs",
    "publish": {
      "provider": "github",
      "owner": "Anir6800",
      "repo": "sippal",
      "releaseType": "release"
    }
  },
  "homepage": "https://github.com/Anir6800/sippal",
  "repository": {
    "type": "git",
    "url": "https://github.com/Anir6800/sippal.git"
  }
}
