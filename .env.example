# Dev conveniences only. The real Gemini key is entered in Settings and stored encrypted.
# Opens DevTools for both windows when set to 1.
SIPPAL_DEVTOOLS=0
# Dev only: send Gemini requests to a local fake server instead of Google (ignored in packaged builds).
# SIPPAL_GEMINI_BASE_URL=http://127.0.0.1:8787
# Dev only: use a separate data folder (e.g. a demo profile for screenshots).
# SIPPAL_USER_DATA=C:/temp/sippal-demo
